animations {
    workspace-switch {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }
    window-open {
        duration-ms 250
        curve "ease-out-cubic"
    }
    window-close {
        duration-ms 200
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }
}
