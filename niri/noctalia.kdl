layout {

    focus-ring {
        active-color   "#aac8f5"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#aac8f5"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#aac8f5"
        inactive-color "#3d5b82"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aac8f580"
    }
}

recent-windows {
    highlight {
        active-color "#aac8f5"
        urgent-color "#ffb4ab"
    }
}
