layout {

    focus-ring {
        active-color   "#7bd1f6"
        inactive-color "#101416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#7bd1f6"
        inactive-color "#101416"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#7bd1f6"
        inactive-color "#4da7ca"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#7bd1f680"
    }
}

recent-windows {
    highlight {
        active-color "#7bd1f6"
        urgent-color "#ffb4ab"
    }
}
