window-rule {
    // open-floating false
    geometry-corner-radius 12
    clip-to-geometry true
    opacity 0.9
    draw-border-with-background false
    focus-ring {
        off
    }
    border {
         on
         width 2
    }
    shadow {
          off
          spread 0
          offset x=0 y=4
          color "#00000040"
          inactive-color "#00000026"
    }
    default-column-width { proportion 0.5; }
    open-fullscreen false
    background-effect {
          blur true
          xray false
          noise 0
          saturation 1
    }
}
window-rule {
 match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

window-rule {
    match app-id="firefox"
    match app-id="md.obsidian.Obsidian"
    match app-id="gimp"
    match app-id="com.obsproject.Studio"
    match app-id="vesktop"
    match app-id="losslesscut"
    match app-id="io.github.celluloid_player.Celluloid"
    match app-id="org.gnome.Evince"
    match app-id="org.gnome.eog"
    match app-id="steam"
    match app-id="nwg-look"
    match app-id="chromium"
    match app-id="libre*"
    default-column-width { proportion 1.0; }
}

window-rule {
  match app-id="org.gnome.Nautilus"
  match app-id="org.localsend.localsend_app"
  match app-id="de.haeckerfelix.Fragments"
  match app-id="usbimager"
  open-floating true
  default-column-width { fixed 800; }
  default-window-height { fixed 550; }
}
window-rule {
    match app-id="org.telegram.desktop"
    match app-id="kitty"
    match app-id="io.github.elyprismlauncher.ElyPrismLauncher"
    default-column-width { proportion 0.66667; }

}
