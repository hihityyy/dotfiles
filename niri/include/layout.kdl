layout {
    always-center-single-column
    gaps 8
    preset-column-widths {
        proportion 1.0
        proportion 0.66667
        proportion 0.5
        proportion 0.33333
    }
    preset-window-heights {
        proportion 0.66667
        proportion 0.5
        proportion 0.33333
        proportion 1.0
    }
}
