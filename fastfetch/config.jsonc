{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/hihitylogo.txt",
    "position": "left",
    "padding": {
      "top": 1,
      "right": 2
    },
    "color": {
      "1": "#ffc463",
      "2": "#dfc063"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#ffc49f",
      "title": "#dfc0ae"
    },
    "disableLinewrap": true,
    "percent": {
      "color": {
        "green": "#d6d497",
        "yellow": "#f4ba95",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}/"
    },
    {
      "type": "custom",
      "key": "├─ system/",
      "keyColor": "blue",
      "format": ""
    },
    {
      "type": "os",
      "key": "│  ├─  OS",
      "keyColor": "blue",
      "format": "Arch Linux"
    },
    {
      "type": "kernel",
      "key": "│  ├─  Kernel",
      "keyColor": "blue",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "│  └─  Uptime",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "key": "├─ shell/",
      "keyColor": "green",
      "format": ""
    },
    {
      "type": "shell",
      "key": "│  ├─ 󰆍 Shell",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "│  ├─ 󱂬 WM",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "│  └─  Term",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "key": "└─ hardware/",
      "keyColor": "yellow",
      "format": ""
    },
    {
      "type": "cpu",
      "key": "   ├─  CPU",
      "keyColor": "yellow",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "   ├─ 󰢮 GPU",
      "keyColor": "yellow",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "   ├─  RAM",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "   └─  Disk",
      "keyColor": "yellow"
    }
  ]
}
